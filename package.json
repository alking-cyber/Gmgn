{
  "name": "gmgn-cli",
  "version": "1.6.6",
  "description": "GMGN OpenAPI CLI \u2014 call GMGN market, token, portfolio and swap APIs from the command line",
  "type": "module",
  "bin": {
    "gmgn-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".cursor-plugin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "publish:provenance": "npm publish --provenance --access public",
    "pipeline": "tsx pipeline/run.ts",
    "pipeline:evaluate": "tsx pipeline/evaluate.ts",
    "pipeline:selftest": "tsx pipeline/selftest.ts --clean && tsx pipeline/selftest-newlaunch.ts --profile newlaunch && tsx pipeline/selftest-paper.ts --profile loose && tsx pipeline/selftest-loose.ts --profile loose && tsx pipeline/selftest-early.ts --profile early && tsx pipeline/selftest-gate.ts",
    "pipeline:history": "tsx pipeline/history.ts",
    "pipeline:newlaunch": "tsx pipeline/run.ts --profile newlaunch",
    "pipeline:loose": "tsx pipeline/run.ts --profile loose",
    "pipeline:early": "tsx pipeline/run.ts --profile early",
    "pipeline:replay": "tsx pipeline/replay.ts --profile loose",
    "pipeline:runners": "tsx pipeline/runner-tracker.ts",
    "pipeline:backtest": "tsx pipeline/backtest.ts --profile early",
    "pipeline:outcomes": "tsx pipeline/outcomes.ts",
    "pipeline:missed": "tsx pipeline/missed.ts",
    "research:wallets": "tsx research/wallets.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "socks": "^2.8.7",
    "undici": "^7.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMGNAI/gmgn-skills"
  },
  "keywords": [
    "gmgn",
    "crypto",
    "solana",
    "token",
    "defi",
    "swap",
    "portfolio",
    "market",
    "claude-skill"
  ]
}
